<Window x:Class="PrintLink.Receiver.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="PrintLink Receiver"
        Width="1280" Height="830"
        MinWidth="1080" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True">

    <Grid>
        <!-- Ambient glows behind the glass cards -->
        <Ellipse Width="520" Height="240" HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,60,-170,0" RenderTransformOrigin="0.5,0.5">
            <Ellipse.Fill>
                <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                    <GradientStop Color="#4019E6FF" Offset="0" />
                    <GradientStop Color="#0019E6FF" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse Width="420" Height="200" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                 Margin="-210,0,0,40">
            <Ellipse.Fill>
                <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                    <GradientStop Color="#26FFFFFF" Offset="0" />
                    <GradientStop Color="#00FFFFFF" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="66" />
                <RowDefinition Height="*" />
                <RowDefinition Height="36" />
            </Grid.RowDefinitions>

            <!-- ===================== Header ===================== -->
            <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="#2BFFFFFF" Padding="24,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#2E05298A" Offset="0" />
                        <GradientStop Color="#0D05298A" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>

                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="42" Height="42" CornerRadius="13"
                                Background="{StaticResource GlassIconBrush}"
                                BorderBrush="#73FFFFFF" BorderThickness="1">
                            <TextBlock Text="&#xE753;" FontFamily="Segoe MDL2 Assets" FontSize="19"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="PrintLink" FontSize="25" FontWeight="Black" Margin="11,0,0,0"
                                   VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" />
                        <Border Style="{StaticResource Pill}" Margin="9,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="RECEIVER" FontSize="9" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="Local network only" FontSize="11" FontWeight="SemiBold" Margin="7,0,0,0"
                                   VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                        <Border Width="1" Background="#40FFFFFF" Height="20" Margin="22,0" />
                        <TextBlock x:Name="ClockTimeText" FontSize="15" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock x:Name="ClockDateText" FontSize="11" Margin="9,0,0,0"
                                   VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===================== Dashboard ===================== -->
            <Grid Grid.Row="1" Margin="24,16,24,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="400" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left column -->
                <Grid Grid.Column="0" Margin="0,0,16,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1.12*" />
                        <RowDefinition Height="0.88*" />
                    </Grid.RowDefinitions>

                    <!-- Listener card -->
                    <Border Grid.Row="0" Style="{StaticResource GlassCard}" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <StackPanel>
                                    <TextBlock Text="CONNECTION" Style="{StaticResource Eyebrow}" />
                                    <TextBlock Text="Listener" Style="{StaticResource CardTitle}" Margin="0,3,0,0" />
                                </StackPanel>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Background="#2E05236F" BorderBrush="#47FFFFFF" BorderThickness="1"
                                        CornerRadius="14" Padding="12,7">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="ListenerDot" Width="7" Height="7"
                                                 Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="ListenerStateText" Text="Listening" FontSize="10"
                                                   FontWeight="SemiBold" Margin="7,0,0,0"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- IP and port -->
                            <Border Grid.Row="1" Margin="0,19,0,0" Padding="16,15" CornerRadius="14"
                                    Background="#29031C6F" BorderBrush="#2BFFFFFF" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="1" />
                                        <ColumnDefinition Width="92" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="LOCAL IPv4" FontSize="8" FontWeight="Bold" Margin="0,0,0,5"
                                                   Foreground="{StaticResource TextMutedBrush}" />
                                        <TextBlock x:Name="LocalIpText" Text="192.168.1.10"
                                                   Style="{StaticResource MonoValue}" />
                                    </StackPanel>

                                    <Border Grid.Column="1" Background="#2BFFFFFF" Margin="0,0,0,0" />

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="TCP PORT" FontSize="8" FontWeight="Bold" Margin="0,0,0,5"
                                                   Foreground="{StaticResource TextMutedBrush}" />
                                        <TextBlock x:Name="PortText" Text="5050" Style="{StaticResource MonoValue}"
                                                   Foreground="{StaticResource AccentCyanBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="2,12,0,13">
                                <TextBlock Text="&#xE701;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Text="Campus-Print · Offline LAN" FontSize="10" Margin="7,0,0,0"
                                           VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>

                            <Button Grid.Row="3" x:Name="ToggleListeningButton"
                                    Style="{StaticResource DangerActionButton}"
                                    Click="ToggleListeningButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="ToggleIconText" Text="&#xE71A;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="11" VerticalAlignment="Center" Margin="0,0,9,0" />
                                    <TextBlock x:Name="ToggleLabelText" Text="Stop Listening" FontSize="12"
                                               FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Save folder card -->
                    <Border Grid.Row="1" Style="{StaticResource GlassCard}" Padding="20" Margin="0,16,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <StackPanel>
                                    <TextBlock Text="DESTINATION" Style="{StaticResource Eyebrow}" />
                                    <TextBlock Text="Save Folder" Style="{StaticResource CardTitle}" Margin="0,3,0,0" />
                                </StackPanel>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Width="38" Height="38" CornerRadius="12"
                                        Style="{StaticResource GlassIcon}">
                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                </Border>
                            </Grid>

                            <TextBlock Grid.Row="1" Text="LOCAL PATH" Style="{StaticResource SmallLabel}"
                                       Margin="0,18,0,7" />

                            <Border Grid.Row="2" Height="40" CornerRadius="11" Padding="12,0"
                                    Background="#3304195B" BorderBrush="#45FFFFFF" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE72E;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"
                                               Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBox Grid.Column="1" x:Name="SavePathBox"
                                             Style="{StaticResource GlassPathBox}"
                                             IsReadOnly="True"
                                             Text="C:\PrintLink\Incoming" />
                                </Grid>
                            </Border>

                            <Grid Grid.Row="3" Margin="0,10,0,0">
                                <TextBlock Text="Locked while listening" FontSize="9" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextMutedBrush}" />
                                <Button x:Name="BrowseButton" Content="Browse" HorizontalAlignment="Right"
                                        Style="{StaticResource GhostButton}"
                                        Click="BrowseButton_Click" />
                            </Grid>

                            <TextBlock Grid.Row="4" x:Name="AllowedTypesText"
                                       Text="PDF &amp; DOCX · 10 MB maximum" FontSize="9" Margin="0,18,0,0"
                                       Foreground="{StaticResource TextMutedBrush}" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- Right column -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="220" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Active transfer card -->
                    <Border Grid.Row="0" Style="{StaticResource GlassCard}" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <StackPanel>
                                    <TextBlock Text="INCOMING QUEUE" Style="{StaticResource Eyebrow}" />
                                    <TextBlock Text="Active Transfer" Style="{StaticResource CardTitle}" Margin="0,3,0,0" />
                                </StackPanel>
                                <Border x:Name="LivePill" Visibility="Collapsed"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Style="{StaticResource Pill}" Padding="9,6">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" Fill="{StaticResource AccentCyanBrush}"
                                                 VerticalAlignment="Center" />
                                        <TextBlock Text="LIVE" FontSize="9" FontWeight="Bold" Margin="6,0,0,0"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid Grid.Row="1">
                                <!-- Idle state: centred tray and two short lines, like the Figma reference -->
                                <StackPanel x:Name="TransferIdlePanel"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="30"
                                               HorizontalAlignment="Center"
                                               Foreground="{StaticResource TextDimBrush}" />
                                    <TextBlock Text="Waiting for files..." FontSize="12" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" Margin="0,12,0,0"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="Ready for a nearby Android sender" FontSize="9"
                                               HorizontalAlignment="Center" Margin="0,4,0,0"
                                               Foreground="{StaticResource TextMutedBrush}" />
                                </StackPanel>

                                <!-- Active state: shown once a transfer starts, hidden while idle -->
                                <Grid x:Name="TransferActivePanel" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="0,14,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="34" Height="34" CornerRadius="11"
                                                    Background="{StaticResource GlassIconBrush}"
                                                    BorderBrush="#73FFFFFF" BorderThickness="1">
                                                <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                            </Border>
                                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="TransferFileNameText" Text="report.pdf"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                                <TextBlock x:Name="TransferSenderText" Text="Pixel 7 &#183; 192.168.1.23"
                                                           FontSize="9" Margin="0,3,0,0" FontFamily="Consolas"
                                                           Foreground="{StaticResource TextMutedBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock x:Name="TransferPercentText" Text="52%" HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" FontSize="25" FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                    </Grid>

                                    <Grid Grid.Row="1" Margin="1,14,1,7">
                                        <TextBlock Text="Receiving file" FontSize="9"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock x:Name="TransferBytesText" Text="4.2 MB / 8.0 MB"
                                                   HorizontalAlignment="Right" FontSize="9" FontFamily="Consolas"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                    </Grid>

                                    <Border Grid.Row="2" Height="9" CornerRadius="5"
                                            Background="#4D02145B" BorderBrush="#2BFFFFFF" BorderThickness="1">
                                        <Border x:Name="TransferProgressBar" HorizontalAlignment="Left"
                                                Width="0" CornerRadius="4" Margin="1">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#FF2473FF" Offset="0" />
                                                    <GradientStop Color="#FF19E6FF" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Border.Effect>
                                                <DropShadowEffect Color="#FF19E6FF" BlurRadius="15"
                                                                  ShadowDepth="0" Opacity="0.6" />
                                            </Border.Effect>
                                        </Border>
                                    </Border>

                                    <Grid Grid.Row="3" Margin="0,12,0,0">
                                        <Border HorizontalAlignment="Left" Background="#1FFFFFFF"
                                                BorderBrush="#33FFFFFF" BorderThickness="1"
                                                CornerRadius="6" Padding="8,3">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="6" Height="6" Fill="{StaticResource AccentCyanBrush}"
                                                         VerticalAlignment="Center" />
                                                <TextBlock x:Name="TransferVerifyText" Text="SHA-256 &#183; Verifying..."
                                                           FontSize="9" Margin="6,0,0,0" VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock x:Name="TransferSpeedText" Text="4.1 MB/s &#183; about 1 sec left"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   FontSize="9" Foreground="{StaticResource TextDimBrush}" />
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Received files card -->
                    <Border Grid.Row="1" Style="{StaticResource GlassCard}" Margin="0,16,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Padding="20,14,18,11"
                                    BorderThickness="0,0,0,1" BorderBrush="#24FFFFFF">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="TODAY'S ACTIVITY" Style="{StaticResource Eyebrow}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <TextBlock Text="Received Files" Style="{StaticResource CardTitle}" />
                                            <Border Background="#1FFFFFFF" BorderBrush="#40FFFFFF"
                                                    BorderThickness="1" CornerRadius="6" Padding="6,1"
                                                    Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="ReceivedCountText" Text="0" FontSize="9"
                                                           Foreground="{StaticResource TextMutedBrush}" />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <Ellipse Width="5" Height="5" Fill="{StaticResource SuccessBrush}"
                                                 VerticalAlignment="Center" />
                                        <TextBlock x:Name="VerifiedLegendText" Text="0 verified" FontSize="8"
                                                   Margin="5,0,13,0" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextMutedBrush}" />
                                        <Ellipse Width="5" Height="5" Fill="{StaticResource DangerSoftBrush}"
                                                 VerticalAlignment="Center" />
                                        <TextBlock x:Name="FailedLegendText" Text="0 failed" FontSize="8"
                                                   Margin="5,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextMutedBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <DataGrid Grid.Row="1" x:Name="ReceivedFilesGrid"
                                      AutoGenerateColumns="False"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserResizeRows="False"
                                      CanUserResizeColumns="False"
                                      CanUserReorderColumns="False"
                                      GridLinesVisibility="None"
                                      HeadersVisibility="Column"
                                      IsReadOnly="True"
                                      RowHeaderWidth="0"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      ColumnHeaderStyle="{StaticResource GlassDataGridHeader}"
                                      CellStyle="{StaticResource GlassDataGridCell}"
                                      RowStyle="{StaticResource GlassDataGridRow}"
                                      Margin="20,4,20,0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="FILE NAME" Width="27*" Binding="{Binding FileName}" />
                                    <DataGridTextColumn Header="RECEIVED" Width="12*" Binding="{Binding ReceivedAt}" />
                                    <DataGridTextColumn Header="SIZE" Width="9*" Binding="{Binding Size}" />
                                    <DataGridTextColumn Header="STATUS" Width="18*" Binding="{Binding Status}" />
                                    <DataGridTextColumn Header="SAVED PATH" Width="28*" Binding="{Binding SavedPath}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ===================== Footer ===================== -->
            <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="#3DFFFFFF" Padding="24,0">
                <Border.Background>
                    <SolidColorBrush Color="#3804155B" />
                </Border.Background>
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="PrintLink" FontSize="9" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text=" · Unofficial student project, not affiliated with any organization"
                                   FontSize="9" Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="FooterStatusText" Text="Ready" FontSize="9" Margin="7,0,0,0"
                                   VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
